{
  "manifest_version": 3,
  "name": "Duel Analyzer",
  "version": "1.4.3943",
  "description": "Realtime duel analyzer overlay",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://godville.net/*",
    "https://a.godville.net/*",
    "https://b.godville.net/*",
    "https://gvl.sanuch.name/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://godville.net/superhero",
        "https://a.godville.net/superhero",
        "https://b.godville.net/superhero",
        "https://godvillegame.com/superhero",
        "https://godville.net/duels/log/*",
        "https://a.godville.net/duels/log/*",
        "https://b.godville.net/duels/log/*",
        "https://godvillegame.com/duels/log/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Duel Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "duel-analyzer@sanuch.name",
      "strict_min_version": "121.0"
    }
  }
}
